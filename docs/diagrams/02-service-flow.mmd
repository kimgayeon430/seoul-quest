flowchart TD
  A["회원가입 · 로그인<br/>(게스트는 둘러보기만)"] --> B["여행 취향 선택<br/>투어·맛집·체험·쇼핑"]
  B --> C["홈: 개인화 추천 상위 3개"]
  C --> D["미션 목록 / 지도에서 미션 선택"]
  D --> E["미션 상세 → 미션 시작"]
  E --> F{"1단계 GPS 인증<br/>목표 반경 200m 이내?"}
  F -- 아니오 --> E
  F -- 예 --> G["1단계 보상 min(포인트,100)"]
  G --> H["2단계 촬영 → 온디바이스 사진 인증"]
  H --> I{"판정"}
  I -- REJECT --> H2["업로드 안 함 · 재촬영 안내"] --> H
  I -- NEEDS_REVIEW --> J["업로드 · 검수 대기<br/>(완료·포인트 보류)"]
  I -- PASS --> K["업로드 · 트랜잭션으로 완료<br/>2단계 보상 · 카운터 · 배지"]
  J --> R{"관리자 사진 검수"}
  R -- 승인 --> K
  R -- 반려 --> H
  K --> L["성취 연출: 포인트 · 레벨업 · 배지"]
  L --> M["결과 화면 + 다음 미션 추천 카드"]
  M --> D
  K --> N["랭킹 · 마이페이지(포인트 내역 · 레벨 · 배지)"]
  subgraph Proposal["사용자 미션 제안"]
    P1["제안 작성<br/>제목·설명·카테고리·이미지·지도 위치"] --> P2["pending (points=0)"]
    P2 --> P3{"관리자 제안 검수"}
    P3 -- 승인: 포인트 확정 --> P4["approved → 목록·지도·추천 노출"]
    P3 -- 수정 요청 --> P5["changes_requested → 재제출"] --> P2
    P3 -- 반려 --> P6["rejected"]
  end
  P4 --> D
